# Copy this file to .env.local and fill in real values for your environment.
# Never commit .env.local — it is already gitignored.

# ---------------------------------------------------------------------------
# PostgreSQL (REQUIRED)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://drugos:drugos_dev_password@localhost:5432/drugos

# ---------------------------------------------------------------------------
# JWT (REQUIRED in production, >=32 chars). Generate with:
#   openssl rand -base64 48
# Must be IDENTICAL between the frontend and backend/ containers — the
# backend verifies JWTs signed by the frontend's auth/server.ts.
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-insecure-secret-change-me-MINIMUM-32-CHARS-FOR-HS256!!
WEBHOOK_SECRET_KEY=00000000000000000000000000000000

# ---------------------------------------------------------------------------
# Python backend services (backend/ FastAPI app — see /backend)
# Run `make serve-api` (or `cd backend && uvicorn main:app --port 8000`)
# then these three URLs make the RL, Knowledge Graph and Dataset pages
# show real data instead of 503 service_not_deployed.
# ---------------------------------------------------------------------------
RL_SERVICE_URL=http://localhost:8000/rl
KG_SERVICE_URL=http://localhost:8000/kg
DATASET_SERVICE_URL=http://localhost:8000/dataset

# Origin the backend's CORS middleware should allow (must match where the
# Next.js app is served from).
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Local CSV / JSON fallback (dev only). Used by the Next.js API routes
# directly when the corresponding *_SERVICE_URL above is unset, so the
# dashboard can show real (if limited) data even before backend/ is running.
# ---------------------------------------------------------------------------
RL_LOCAL_CSV=../rl/validated_hypotheses.csv
KG_REGISTRY_PATH=../phase2/data/registry.json
DATASET_CHECKPOINT_PATH=../phase2/data/checkpoints/step_01.json

# Neo4j (used by backend/, not the frontend directly)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=drugos_dev_password

# ---------------------------------------------------------------------------
# External biomedical APIs (optional — search endpoints degrade gracefully
# without keys, but rate limits are much lower)
# ---------------------------------------------------------------------------
PATENTSVIEW_API_KEY=
NCBI_API_KEY=
